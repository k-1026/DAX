# 이 파일을 복사해 .env.local 로 이름을 바꾼 뒤 값을 채우세요.
# .env.local 은 GitHub에 올라가지 않습니다. (비밀값 보관용)

# Supabase 대시보드 > Project Settings > API Keys / Data API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# 수집 API 인증값 (임의의 긴 문자열)
INGEST_SECRET=
# Supabase 대시보드 > Project Settings > API Keys 의 Secret key. 서버 전용이며 화면 코드에서 쓰면 안 됩니다.
SUPABASE_SERVICE_ROLE_KEY=

# 메일 (Resend)
RESEND_API_KEY=
# live 로 설정하기 전까지는 시험 주소로만 발송합니다.
MAIL_MODE=test
MAIL_FROM=
MAIL_CONTACT=
NEXT_PUBLIC_SITE_URL=
# 수신 거부 링크 서명값, 예약 실행 인증값 (임의의 긴 문자열)
UNSUBSCRIBE_SECRET=
CRON_SECRET=
# 경보 메일 받을 관리자 주소 (여러 개면 쉼표로 구분)
MONITOR_ALERT_TO=
# 비로그인 IP를 해시로 바꿀 때 쓰는 비밀값 (임의의 긴 문자열)
IP_HASH_SECRET=

# 시험 사이트 입장 비밀번호 (Vercel 시험 배포에만 넣기. 비워 두면 입장 확인 없음)
SITE_GATE_PASSWORD=
